{
  "name": "neverending-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "nq": "./src/cli.ts"
  },
  "scripts": {
    "nq": "bun run src/cli.ts",
    "watch": "bun --watch scripts/watch.ts",
    "test": "bun test --timeout 20000",
    "typecheck": "bun scripts/typecheck.ts",
    "eval:memory": "bun run scripts/eval-memory.ts",
    "postinstall": "bun run scripts/apply-openrouter-reasoning-patch.ts && bun run scripts/apply-openai-payload-hook-patch.ts && bun run scripts/apply-transient-retry-patch.ts",
    "hosted:build": "bun run src/surfaces/hosted/build.ts",
    "hosted:dev": "bun run src/surfaces/hosted/build.ts && bunx wrangler dev -c src/surfaces/hosted/wrangler.jsonc",
    "hosted:deploy": "bun run src/surfaces/hosted/build.ts && bunx wrangler deploy -c src/surfaces/hosted/wrangler.jsonc"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@puppeteer/browsers": "3.0.6",
    "@testing-library/dom": "8.20.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.2",
    "puppeteer-core": "25.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nq/local-inference": "workspace:*",
    "@nq/seal": "workspace:*",
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "@gnuton/css-dice-roller": "^0.8.5",
    "@oh-my-pi/pi-ai": "17.0.9",
    "@oh-my-pi/pi-catalog": "17.0.9",
    "@oh-my-pi/pi-coding-agent": "17.0.9",
    "@oh-my-pi/pi-utils": "17.0.9",
    "@opentui/core": "0.5.2",
    "effect": "3.22.1",
    "isomorphic-git": "^1.41.4",
    "preact": "10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
